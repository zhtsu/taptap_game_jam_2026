[gd_scene format=3]

[ext_resource type="Script" path="res://ui/plan/plan.gd" id="1_plan"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_plan_back"]
content_margin_left = 12.0
content_margin_top = 12.0
content_margin_right = 12.0
content_margin_bottom = 12.0
bg_color = Color(0.0705882, 0.0705882, 0.0784314, 1)

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_plan_back_hover"]
content_margin_left = 12.0
content_margin_top = 12.0
content_margin_right = 12.0
content_margin_bottom = 12.0
bg_color = Color(0.109804, 0.109804, 0.121569, 1)

[node name="Plan" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_plan")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.0392157, 0.0392157, 0.0470588, 1)

[node name="TopBar" type="HBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
offset_left = 50.0
offset_top = 50.0
offset_right = -50.0
offset_bottom = 170.0
grow_horizontal = 2

[node name="Title" type="Label" parent="TopBar"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
theme_override_font_sizes/font_size = 48
text = "ui.plan.title"
vertical_alignment = 1

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_top = 180.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 50
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 50
theme_override_constants/margin_bottom = 200

[node name="Scroll" type="ScrollContainer" parent="Margin"]
layout_mode = 2
horizontal_scroll_mode = 0

[node name="PlanList" type="VBoxContainer" parent="Margin/Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
theme_override_constants/separation = 28

[node name="BackButton" type="Button" parent="."]
unique_name_in_owner = true
custom_minimum_size = Vector2(240, 120)
layout_mode = 1
anchors_preset = 2
anchor_top = 1.0
anchor_bottom = 1.0
offset_left = 50.0
offset_top = -170.0
offset_right = 290.0
offset_bottom = -50.0
grow_vertical = 0
mouse_default_cursor_shape = 2
theme_override_font_sizes/font_size = 48
theme_override_styles/normal = SubResource("StyleBoxFlat_plan_back")
theme_override_styles/pressed = SubResource("StyleBoxFlat_plan_back_hover")
theme_override_styles/hover = SubResource("StyleBoxFlat_plan_back_hover")
theme_override_styles/focus = SubResource("StyleBoxFlat_plan_back_hover")
text = "ui.workshop.back"

[node name="NewPlanButton" type="Button" parent="."]
unique_name_in_owner = true
custom_minimum_size = Vector2(240, 120)
layout_mode = 1
anchors_preset = 3
anchor_left = 1.0
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = -290.0
offset_top = -170.0
offset_right = -50.0
offset_bottom = -50.0
grow_horizontal = 0
grow_vertical = 0
mouse_default_cursor_shape = 2
theme_override_font_sizes/font_size = 48
theme_override_styles/normal = SubResource("StyleBoxFlat_plan_back")
theme_override_styles/pressed = SubResource("StyleBoxFlat_plan_back_hover")
theme_override_styles/hover = SubResource("StyleBoxFlat_plan_back_hover")
theme_override_styles/focus = SubResource("StyleBoxFlat_plan_back_hover")
text = "ui.plan.new"

[connection signal="pressed" from="BackButton" to="." method="_on_back_pressed"]
[connection signal="pressed" from="NewPlanButton" to="." method="_on_new_plan_pressed"]
